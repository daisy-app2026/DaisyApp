{
  "expo": {
    "name": "Daisy",
    "slug": "daisy-app",
    "scheme": "daisy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "androidStatusBar": {
      "backgroundColor": "#1A3A0F",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daisyapp.mobile",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Daisy needs camera access to add photos to your diary entries.",
        "NSMicrophoneUsageDescription": "Daisy needs microphone access to record audio diary entries.",
        "NSPhotoLibraryUsageDescription": "Daisy needs photo library access to add images to your diary entries.",
        "NSPhotoLibraryAddUsageDescription": "Daisy needs access to save images to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1A3A0F"
      },
      "package": "com.daisyapp.mobile",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "windowSoftInputMode": "adjustResize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "googleServicesFile": "./google-services.json",
          "iosUrlScheme": "com.googleusercontent.apps.173246095861-0b6ofp4dc6f6rn8dju3acibkrt55tsc9"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#1A3A0F",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2a6d8f1f-9810-4930-8806-069818631e4e"
      }
    }
  }
}
